{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/reviews/:action",
      "destination": "/api/bookings?reviewAction=:action"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/marketing/run",
      "schedule": "0 1 * * *"
    }
  ]
}
