# Email các tài khoản Supabase được làm Admin, phân tách bằng dấu phẩy (giao diện + server)
VITE_ADMIN_EMAILS=
# Hoặc số điện thoại của tài khoản đăng ký bằng SĐT (không nhập email), phân tách bằng dấu phẩy
VITE_ADMIN_PHONES=

# ── SEO Radar ──────────────────────────────────────────────────────────────────
# Google PageSpeed Insights API Key
# Lấy tại: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: "PageSpeed Insights API"
VITE_PAGESPEED_KEY=

# Google Search Console (OAuth Client ID)
# Lấy tại: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# Enable: "Google Search Console API"
# Authorized redirect URI: http://localhost:5173 (dev) và https://meovangnha.store (prod)
VITE_GSC_CLIENT_ID=

# ── Web Push (Marketing tự động) ───────────────────────────────────────────────
# Tạo bằng: node scripts/generate-vapid.js  (KHÔNG commit khóa thật)
VAPID_PUBLIC_KEY=REPLACE_ME
VAPID_PRIVATE_KEY=REPLACE_ME
VITE_VAPID_PUBLIC_KEY=REPLACE_ME
VAPID_SUBJECT=mailto:contact@meovangnha.com
# Chuỗi bí mật cho Vercel Cron gọi /api/marketing/run hằng ngày
CRON_SECRET=REPLACE_ME

# ── Camera Imou (ô "Camera trực tiếp" trong Theo dõi lưu trú) ─────────────────
# Lấy tại https://open.imoulife.com (đăng nhập bằng tài khoản Imou đang gắn camera) → tạo ứng dụng → AppId / AppSecret.
# KHÔNG đặt tên bắt đầu bằng VITE_ (khoá sẽ lộ ra trình duyệt). Không bao giờ ghi mật khẩu tài khoản Imou vào đây.
IMOU_APP_ID=
IMOU_APP_SECRET=
# Trung tâm dữ liệu: sg (Singapore, mặc định cho Việt Nam), fk (châu Âu), or (châu Mỹ)
IMOU_DATA_CENTER=sg
# Không bắt buộc: số serial camera mặc định (để trống thì tự lấy camera đầu tiên đang online của tài khoản)
IMOU_DEVICE_ID=
# Không bắt buộc: mỗi phòng một camera, dạng JSON {"VIP-01":"SERIAL1","VVIP-01":"SERIAL2:0"}
IMOU_ROOM_CAMERAS=
# Chỉ để chạy thử khi chưa có camera: một link HLS https bất kỳ. Khi đã điền IMOU_APP_ID/SECRET thì biến này bị bỏ qua.
IMOU_TEST_HLS=
# Chế độ DEMO (chỉ để trình diễn/Preview, KHÔNG bật trên web thật): đặt 1 thì ô camera hiện hình minh hoạ từ ảnh phòng, gắn nhãn "Hình minh hoạ", không có nhãn LIVE.
IMOU_DEMO_CAMERA=
