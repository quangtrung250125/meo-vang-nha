# ── SEO Radar ──────────────────────────────────────────────────────────────────
# Google PageSpeed Insights API Key
# Lấy tại: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: "PageSpeed Insights API"
VITE_PAGESPEED_KEY=

# Google Search Console (OAuth Client ID)
# Lấy tại: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# Enable: "Google Search Console API"
# Authorized redirect URI: http://localhost:5173 (dev) và https://meovangnha.store (prod)
VITE_GSC_CLIENT_ID=

# ── Web Push (Marketing tự động) ───────────────────────────────────────────────
